[Unit]
Description=stickersbot database sync with Google Drive
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/bots/stickersbot
# uploads bot_data.db when it changed; merges stickers.db and restarts the bot only when the
# laptop pushed new stickers (config: /opt/bots/stickersbot/dbsync.toml)
ExecStart=/opt/bots/stickersbot/.venv/bin/python tools/dbsync.py all
Nice=10
